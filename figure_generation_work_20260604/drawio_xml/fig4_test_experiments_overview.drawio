        <mxCell id="RpC" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=12;fontColor=#333333;align=center;verticalAlign=middle;" value="MONO 基准，1K→100K：runtime 0.5→25 s、peak memory ≤ 0.31 GB，AUROC/ACC 跨规模基本稳定；基于 subsampling / bootstrap scaling，非端到端实测" vertex="1">
